-- [2.6] DISCORD WEBHOOK SYSTEM
-- ═══════════════════════════════════════════════════════════════════════════════
local Webhook = {}
Webhook.__index = Webhook
local webhookQueue = {}
local webhookSending = false
local webhookCooldowns = {}

local WEBHOOK_COLORS = { info = 3447003, success = 5763719, warning = 16776960, danger = 15548997, fruit = 16711935, boss = 16750592, level = 10181046 }

local function BuildEmbed(data)
    local fields = data.Fields or {}
    table.insert(fields, { name = "👤 Player", value = "```" .. LP.Name .. "```", inline = true })
    table.insert(fields, { name = "📊 Level", value = "```" .. tostring(GetLevel()) .. "```", inline = true })
    table.insert(fields, { name = "🌍 Sea", value = "```" .. tostring(State.World) .. "```", inline = true })
    return { title = data.Title or "Chuppy Hub", description = data.Description or "", color = data.Color or WEBHOOK_COLORS.info, fields = fields, footer = { text = "Chuppy Hub V2 | " .. os.date("%H:%M:%S") }, timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ") }
end

local function ProcessQueue()
    if webhookSending then return end
    if #webhookQueue == 0 then return end
    webhookSending = true
    local item = table.remove(webhookQueue, 1)
    local url = item.url; local payload = item.payload; local type_ = item.type
    local req = request or http_request or (syn and syn.request) or (http and http.request)
    if not req then webhookSending = false; return end
    SafeSpawn(function()
        local ok = pcall(function() req({ Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode(payload) }) end)
        if not ok then warn("[Chuppy Webhook] Send failed") end
        task.wait(Constant.WEBHOOK_COOLDOWN)
        webhookSending = false
        if #webhookQueue > 0 then ProcessQueue() end
    end)
end

function Webhook.Send(config)
    config = config or {}
    if not State.WebhookEnabled then return end
    if not State.WebhookURL or State.WebhookURL == "" then return end
    local type_ = config.Type or "info"
    local now = tick()
    if webhookCooldowns[type_] and (now - webhookCooldowns[type_]) < Constant.WEBHOOK_COOLDOWN then return end
    webhookCooldowns[type_] = now
    local embed = BuildEmbed({ Title = config.Title, Description = config.Description, Color = config.Color or WEBHOOK_COLORS[type_] or WEBHOOK_COLORS.info, Fields = config.Fields })
    local content = config.Content or ""
    if config.Ping then content = "@everyone" end
    local payload = { content = content, username = "Chuppy Hub V2", avatar_url = "https://cdn.discordapp.com/embed/avatars/0.png", embeds = { embed } }
    if #webhookQueue >= Constant.WEBHOOK_MAX_QUEUE then table.remove(webhookQueue, 1) end
    table.insert(webhookQueue, { url = State.WebhookURL, payload = payload, type = type_ })
    ProcessQueue()
end

function Webhook.Info(title, desc, fields) Webhook.Send({ Type = "info", Title = title, Description = desc, Fields = fields }) end
function Webhook.Success(title, desc, fields) Webhook.Send({ Type = "success", Title = title, Description = desc, Fields = fields }) end
function Webhook.Warning(title, desc, fields) Webhook.Send({ Type = "warning", Title = title, Description = desc, Fields = fields }) end
function Webhook.Danger(title, desc, fields) Webhook.Send({ Type = "danger", Title = title, Description = desc, Fields = fields }) end

function Webhook.Fruit(fruitName, price)
    if not State.WebhookNotiFruit then return end
    Webhook.Send({ Type = "fruit", Title = "🍎 Fruit Found", Description = "Đã tìm thấy **" .. fruitName .. "**", Fields = { { name = "💰 Giá", value = "```" .. tostring(price or "?") .. "```", inline = true } } })
end

function Webhook.Boss(bossName, drops)
    if not State.WebhookNotiBoss then return end
    Webhook.Send({ Type = "boss", Title = "👑 Boss Defeated", Description = "Đã hạ gục **" .. bossName .. "**", Fields = { { name = "🎁 Drops", value = "```" .. tostring(drops or "Không có") .. "```", inline = false } } })
end

function Webhook.LevelUp(oldLv, newLv) Webhook.Send({ Type = "level", Title = "⬆️ Level Up", Description = "Level: **" .. oldLv .. "** → **" .. newLv .. "**" }) end

function Webhook.Test()
    if not State.WebhookURL or State.WebhookURL == "" then Notify("Lỗi", "Chưa nhập URL webhook", "danger"); return end
    Webhook.Send({ Type = "info", Title = "🔔 Test Webhook", Description = "Webhook hoạt động tốt!" })
end
getgenv().ChuppyWebhook = Webhook

