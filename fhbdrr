-- [2.5] MONSTER / MOB HELPERS
-- ═══════════════════════════════════════════════════════════════════════════════
local Monster = {}

function Monster.Find(name)
    local search = name and string.lower(name) or nil
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, v in pairs(enemiesFolder:GetChildren()) do
            if v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                if not search or string.find(string.lower(v.Name), search, 1, true) then return v end
            end
        end
    end
    if search then
        for _, v in pairs(Workspace:GetChildren()) do
            if v:IsA("Model") and string.find(string.lower(v.Name), search, 1, true) and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then return v end
        end
    end
    if name then
        local rsMob = ReplicatedStorage:FindFirstChild(name)
        if rsMob and rsMob:FindFirstChild("HumanoidRootPart") then return rsMob end
    end
    return nil
end

function Monster.FindNearest(maxDistance)
    maxDistance = maxDistance or 5000
    local hrp = GetHRP()
    if not hrp then return nil end
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end
    local nearest, shortest = nil, maxDistance
    for _, v in pairs(enemiesFolder:GetChildren()) do
        if v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            local d = (v.HumanoidRootPart.Position - hrp.Position).Magnitude
            if d < shortest then shortest = d; nearest = v end
        end
    end
    return nearest
end

function Monster.FindInRange(range)
    range = range or 300
    local hrp = GetHRP()
    if not hrp then return {} end
    local list = {}
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return list end
    for _, v in pairs(enemiesFolder:GetChildren()) do
        if v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            local d = (v.HumanoidRootPart.Position - hrp.Position).Magnitude
            if d <= range then table.insert(list, { mob = v, distance = d }) end
        end
    end
    table.sort(list, function(a, b) return a.distance < b.distance end)
    return list
end

function Monster.Bring(mob, targetCF)
    if not mob or not mob:FindFirstChild("HumanoidRootPart") then return end
    pcall(function()
        local hrp = mob.HumanoidRootPart
        local hum = mob:FindFirstChildOfClass("Humanoid")
        hrp.CFrame = targetCF
        if hum then hum.JumpPower = 0; hum.WalkSpeed = 0 end
        hrp.CanCollide = false
        if not hrp:FindFirstChild("BringLock") then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "BringLock"; bv.MaxForce = Vector3.new(1e5, 1e5, 1e5); bv.Velocity = Vector3.zero; bv.Parent = hrp
        end
    end)
end

function Monster.BringAll(mobs, targetCF, radius)
    radius = radius or 200
    if not targetCF then return end
    local hrp = GetHRP()
    if not hrp then return end
    for _, mob in ipairs(mobs or {}) do
        local m = mob.mob or mob
        if m and m:FindFirstChild("HumanoidRootPart") then
            local dist = (m.HumanoidRootPart.Position - hrp.Position).Magnitude
            if dist <= radius then Monster.Bring(m, targetCF) end
        end
    end
end

function Monster.IsAlive(mob)
    if not mob or not mob.Parent then return false end
    local hum = mob:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local BOSS_KEYWORDS = { "King", "Lord", "Boss", "Prince", "Queen", "Beast", "Reaper", "Admiral", "Warden", "Leader" }
function Monster.IsBoss(mob)
    if not mob then return false end
    for _, kw in ipairs(BOSS_KEYWORDS) do if string.find(mob.Name, kw, 1, true) then return true end end
    return false
end

function Monster.Count()
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return 0 end
    local count = 0
    for _, v in pairs(enemiesFolder:GetChildren()) do if Monster.IsAlive(v) then count = count + 1 end end
    return count
end

function Monster.ClearIgnored()
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return end
    for _, v in pairs(enemiesFolder:GetChildren()) do local ig = v:FindFirstChild("Ignored"); if ig then ig:Destroy() end end
end
getgenv().ChuppyMonster = Monster

