local Tooltip = {}
local tFrame, tVisible = nil, false

local function InitTooltip(gui)
    if tFrame and tFrame.Parent then return end
    tFrame = U.New("Frame", {
        Name = "TooltipFrame", Size = UDim2.new(0, 0, 0, 26),
        Position = UDim2.new(0, 0, 0, 0), BackgroundColor3 = Theme.Surface3,
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 99999, Visible = false,
    }, gui)
    U.Corner(Theme.RadiusSmall, tFrame)
    U.Stroke(Theme.BorderLight, 1, 1, tFrame)
    U.New("TextLabel", {
        Name = "Label", Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1, Text = "", Font = Theme.FontMedium, TextSize = Theme.SizeSmall,
        TextColor3 = Theme.Text, TextTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 100000,
    }, tFrame)
end

function Tooltip.Show(text, x, y)
    if not tFrame or not tFrame.Parent or not text or text == "" then return end
    local label = tFrame:FindFirstChild("Label")
    if not label then return end
    local bounds = U.TextSize(Theme.FontMedium, Theme.SizeSmall, text)
    local w = math.max(50, bounds.X + 20); local h = 26
    label.Text = text
    tFrame.Size = UDim2.new(0, w, 0, h)
    tFrame.Position = UDim2.new(0, x - w / 2, 0, y)
    if not tVisible then
        tVisible = true
        tFrame.Visible = true
        tFrame.BackgroundTransparency = 0.05
        U.Tween(label, Theme.AnimFast, { TextTransparency = 0 })
    end
end

function Tooltip.Hide()
    if not tFrame or not tFrame.Parent then return end
    tVisible = false
    local label = tFrame:FindFirstChild("Label")
    if label then U.Tween(label, Theme.AnimFast, { TextTransparency = 1 }) end
    U.Tween(tFrame, Theme.AnimFast, { BackgroundTransparency = 1 })
    task.delay(0.2, function()
        if tFrame and tFrame.Parent and not tVisible then tFrame.Visible = false end
    end)
end

function Tooltip.Attach(element, text)
    if not element or not text then return end
    local hoverTime, isHovering = 0, false
    element.MouseEnter:Connect(function()
        isHovering = true; hoverTime = tick()
        task.delay(0.4, function()
            if isHovering and (tick() - hoverTime) >= 0.35 then
                local pos, size = element.AbsolutePosition, element.AbsoluteSize
                Tooltip.Show(text, pos.X + size.X / 2, pos.Y - 32)
            end
        end)
    end)
    element.MouseLeave:Connect(function() isHovering = false; Tooltip.Hide() end)
end

getgenv().ChuppyTooltip = Tooltip

