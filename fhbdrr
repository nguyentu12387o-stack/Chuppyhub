        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    }, frame)

    local arrow = U.New("TextLabel", {
        Name = "Arrow", Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(1, -26, 0, 0),
        BackgroundTransparency = 1, Text = "▾", Font = Theme.FontBlack,
        TextSize = 14, TextColor3 = Theme.Accent,
    }, frame)

    local clickBtn = U.New("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, ZIndex = 4,
    }, frame)

    local menu = U.New("ScrollingFrame", {
        Name = "Menu", Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 1, 4),
        BackgroundColor3 = Theme.Background, BorderSizePixel = 0, ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent, AutomaticCanvasSize = Enum.AutomaticSize.Y,
