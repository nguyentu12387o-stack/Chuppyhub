    U.Stroke(Theme.BorderLight, 1, 0, menu)
    U.New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, menu)
    U.Padding(4, 4, 4, 4, menu)

    local selected = {}
    if multi and type(default) == "table" then
        for _, v in ipairs(default) do selected[v] = true end
    else
        selected[default] = true
    end
    local currentValue = default

    local searchBox
    if search then
        searchBox = U.New("TextBox", {
            Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0,
            Text = "", PlaceholderText = "🔍 Tìm kiếm...", PlaceholderColor3 = Theme.TextMuted,
            Font = Theme.FontRegular, TextSize = Theme.SizeSmall, TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, LayoutOrder = 0,
        }, menu)
        U.Corner(Theme.RadiusSmall, searchBox)
        U.Padding(0, 0, 8, 8, searchBox)
    end

    local optBtns = {}
    for i, opt in ipairs(options) do
        local optBtn = U.New("TextButton", {
            Name = "Opt_" .. tostring(opt), Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0,
            Text = "  " .. tostring(opt), Font = Theme.FontRegular, TextSize = Theme.SizeSmall,
            TextColor3 = selected[opt] and Theme.Accent or Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
            LayoutOrder = i + (search and 1 or 0),
        }, menu)
        U.Corner(Theme.RadiusSmall, optBtn)
        table.insert(optBtns, { btn = optBtn, name = tostring(opt) })

        optBtn.MouseEnter:Connect(function() U.Tween(optBtn, Theme.AnimFast, { BackgroundColor3 = Theme.Surface3 }) end)
        optBtn.MouseLeave:Connect(function() U.Tween(optBtn, Theme.AnimFast, { BackgroundColor3 = Theme.Surface2 }) end)
        optBtn.MouseButton1Click:Connect(function()
            if multi then
                selected[opt] = not selected[opt]
                optBtn.TextColor3 = selected[opt] and Theme.Accent or Theme.Text
                local selList = {}
                for k, v in pairs(selected) do if v then table.insert(selList, k) end end
                currentValue = selList
                valueLabel.Text = name .. ": " .. (#selList > 0 and table.concat(selList, ", ") or "None")
                if callback then pcall(callback, selList) end
            else
                for _, data in ipairs(optBtns) do data.btn.TextColor3 = Theme.Text end
                optBtn.TextColor3 = Theme.Accent
                currentValue = opt
                selected = { [opt] = true }
                valueLabel.Text = name .. ": " .. tostring(opt)
                menu.Visible = false
                U.Tween(menu, Theme.AnimFast, { Size = UDim2.new(1, 0, 0, 0) })
                U.Tween(arrow, Theme.AnimFast, { Rotation = 0 })
                if callback then pcall(callback, opt) end
            end
        end)
    end

    if searchBox then
        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            local txt = searchBox.Text:lower()
            for _, data in ipairs(optBtns) do
                data.btn.Visible = txt == "" or data.name:lower():find(txt, 1, true) ~= nil
            end
        end)
    end

    local isOpen = false
    clickBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            task.wait()
            local layout = menu:FindFirstChildOfClass("UIListLayout")
            local h = math.min((layout and layout.AbsoluteContentSize.Y or 30) + 10, 180)
            menu.Visible = true
            U.Tween(menu, Theme.AnimSpring, { Size = UDim2.new(1, 0, 0, h) })
            U.Tween(arrow, Theme.AnimSpring, { Rotation = 180 })
            U.Tween(frameStroke, Theme.AnimFast, { Color = Theme.Accent, Transparency = 0.3 })
        else
            U.Tween(menu, Theme.AnimFast, { Size = UDim2.new(1, 0, 0, 0) })
            U.Tween(arrow, Theme.AnimFast, { Rotation = 0 })
            U.Tween(frameStroke, Theme.AnimFast, { Color = Theme.Border, Transparency = 0.7 })
            task.delay(0.15, function() if not isOpen then menu.Visible = false end end)
        end
    end)

    clickBtn.MouseEnter:Connect(function() U.Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.Surface3 }) end)
    clickBtn.MouseLeave:Connect(function() U.Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.Surface2 }) end)

    return {
        Set = function(v)
            if multi then
                selected = {}
                for _, val in ipairs(v) do selected[val] = true end
                currentValue = v
                for _, data in ipairs(optBtns) do data.btn.TextColor3 = selected[data.name] and Theme.Accent or Theme.Text end
                valueLabel.Text = name .. ": " .. (#v > 0 and table.concat(v, ", ") or "None")
            else
                selected = { [v] = true }
                currentValue = v
                for _, data in ipairs(optBtns) do data.btn.TextColor3 = (data.name == v) and Theme.Accent or Theme.Text end
                valueLabel.Text = name .. ": " .. tostring(v)
            end
            if callback then pcall(callback, v) end
        end,
        Get = function() return currentValue end,
    }
end

