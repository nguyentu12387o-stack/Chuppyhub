-- ═══════════════════════════════════════════════════════════════════════════════
local Anim = {}
local activeGlows = {}

function Anim.Pulse(obj, scale, duration)
    if not obj or not obj.Parent then return end
    scale = scale or 1.05; duration = duration or 0.3
    local origSize = obj.Size
    local info = TweenInfo.new(duration / 2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local t = Svc.TweenService:Create(obj, info, {
        Size = UDim2.new(origSize.X.Scale * scale, origSize.X.Offset * scale,
                        origSize.Y.Scale * scale, origSize.Y.Offset * scale),
    })
    t:Play()
    t.Completed:Connect(function()
        if obj and obj.Parent then
            Svc.TweenService:Create(obj, info, { Size = origSize }):Play()
        end
    end)
end

function Anim.Ripple(parent, x, y, color)
    if not parent or not parent.Parent then return end
    color = color or Theme.Accent
    local ripple = U.New("Frame", {
        Name = "RippleEffect", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, x, 0, y), Size = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = color, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 10,
    }, parent)
    U.Corner(Theme.RadiusFull, ripple)
    local maxSize = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 2
    U.Tween(ripple, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, maxSize, 0, maxSize), BackgroundTransparency = 1,
    })
    task.delay(0.7, function() if ripple and ripple.Parent then ripple:Destroy() end end)
end

function Anim.StartGlow(obj, stroke, baseColor, glowColor)
    if not obj or not obj.Parent or not stroke then return end
    if activeGlows[obj] then activeGlows[obj]:Disconnect(); activeGlows[obj] = nil end
    baseColor = baseColor or Theme.Border; glowColor = glowColor or Theme.AccentGlow
    local startTime = tick(); local period = 1.5
    activeGlows[obj] = Svc.RunService.Heartbeat:Connect(function()
        if not obj or not obj.Parent or not stroke or not stroke.Parent then
            if activeGlows[obj] then activeGlows[obj]:Disconnect(); activeGlows[obj] = nil end
            return
        end
        local t = ((tick() - startTime) % period) / period
        local alpha = (math.sin(t * math.pi * 2) + 1) / 2
        alpha = 0.3 + alpha * 0.5
        stroke.Color = U.LerpColor(baseColor, glowColor, alpha)
        stroke.Transparency = 1 - alpha
    end)
end

function Anim.StopGlow(obj)
    if activeGlows[obj] then activeGlows[obj]:Disconnect(); activeGlows[obj] = nil end
end

function Anim.Shake(obj, intensity, duration)
    if not obj or not obj.Parent then return end
    intensity = intensity or 5; duration = duration or 0.3
    local origPos = obj.Position; local startTime = tick(); local conn
    conn = Svc.RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        if elapsed >= duration or not obj or not obj.Parent then
            if obj and obj.Parent then obj.Position = origPos end
            if conn then conn:Disconnect() end
            return
        end
        local progress = 1 - (elapsed / duration)
        obj.Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + math.random(-intensity, intensity) * progress,
                                origPos.Y.Scale, origPos.Y.Offset + math.random(-intensity, intensity) * progress)
    end)
end

function Anim.RotateChevron(chevron, toAngle, duration)
    if not chevron or not chevron.Parent then return end
    duration = duration or 0.25
    U.Tween(chevron, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Rotation = toAngle })
end

getgenv().ChuppyAnim = Anim

