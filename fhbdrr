Config.SaveKeys = {
    "AutoFarm", "AutoFarmBoss", "AutoFarmMaterial", "AutoFarmChest", "AutoHaki", "AutoStoreFruit", "CurrentWeapon", "CurrentFarmMode",
    "AutoRaid", "AutoSeaBeast", "AutoLeviathan", "AutoRace", "AutoCDK", "AutoRedeem", "KillAura", "AimbotEnabled", "ESPFruit", "ESPChest",
