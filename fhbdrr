-- [3.3] TELEPORT HELPERS (Phải đặt trước QuestAction)
-- ═══════════════════════════════════════════════════════════════════════════════
local Farm = {}
local currentTween = nil
local currentTweenTarget = nil

function Farm.Teleport(targetCF, speed)
    if not targetCF then return false end
    local hrp = PlayerUtils.GetHRP()
    if not hrp then return false end
    speed = speed or State.FarmSpeed or 350

    if currentTween then pcall(function() currentTween:Cancel() end); currentTween = nil end

    local dist = (hrp.Position - targetCF.Position).Magnitude
    if dist < 3 then hrp.CFrame = targetCF; return true end

    local time = math.clamp(dist / speed, 0.05, 5)
    local tween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), { CFrame = targetCF })
    currentTween = tween
    currentTweenTarget = targetCF
    tween:Play()

    tween.Completed:Once(function()
        if currentTween == tween then currentTween = nil; currentTweenTarget = nil end
    end)
    return true
end

function Farm.StopTween()
    if currentTween then pcall(function() currentTween:Cancel() end); currentTween = nil; currentTweenTarget = nil end
end

function Farm.Snap(targetCF)
    local hrp = PlayerUtils.GetHRP()
    if not hrp or not targetCF then return false end
    hrp.CFrame = targetCF
    return true
end

function Farm.TeleportAbove(targetCF, height)
    height = height or 20
    return Farm.Teleport(targetCF + Vector3.new(0, height, 0))
end
getgenv().ChuppyFarm = Farm

