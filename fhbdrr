-- ═══════════════════════════════════════════════════════════════════════════════
local Notification = {}
local notiStack, notiHolder = {}, nil
local NOTI_W, NOTI_H, NOTI_GAP = 300, 68, 8

local NOTI_ICONS = { info = "ℹ", success = "✓", warning = "⚠", danger = "✕", loading = "◌" }
local NOTI_COLORS = {
    info = function() return Theme.Info end,
    success = function() return Theme.Success end,
    warning = function() return Theme.Warning end,
    danger = function() return Theme.Danger end,
    loading = function() return Theme.Accent end,
}

local function InitNotiHolder(gui)
    if notiHolder and notiHolder.Parent then return end
    notiHolder = U.New("Frame", {
        Name = "NotificationHolder", Size = UDim2.new(0, NOTI_W, 0, 0),
        Position = UDim2.new(0, 12, 0, 60), BackgroundTransparency = 1, ZIndex = 9999,
    }, gui)
end

local function ReorganizeNoti()
    local yPos = 0
    for _, noti in ipairs(notiStack) do
        if noti.frame and noti.frame.Parent then
            U.Tween(noti.frame, Theme.AnimNormal, { Position = UDim2.new(0, 0, 0, yPos) })
            yPos = yPos + NOTI_H + NOTI_GAP
        end
    end
end

local function DismissNoti(noti)
    if not noti or not noti.frame or not noti.frame.Parent then return end
    for i, n in ipairs(notiStack) do
        if n == noti then table.remove(notiStack, i); break end
    end
    if noti.timerConn then pcall(function() noti.timerConn:Disconnect() end) end
    local frame = noti.frame
    U.Tween(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
        Position = UDim2.new(0, -NOTI_W - 20, 0, frame.Position.Y.Offset), BackgroundTransparency = 1,
    })
    for _, desc in ipairs(frame:GetDescendants()) do
        if desc:IsA("TextLabel") then U.Tween(desc, Theme.AnimFast, { TextTransparency = 1 })
        elseif desc:IsA("TextButton") then U.Tween(desc, Theme.AnimFast, { TextTransparency = 1, BackgroundTransparency = 1 })
        elseif desc:IsA("Frame") then U.Tween(desc, Theme.AnimFast, { BackgroundTransparency = 1 })
        elseif desc:IsA("UIStroke") then U.Tween(desc, Theme.AnimFast, { Transparency = 1 }) end
    end
    task.delay(0.3, function()
        if frame and frame.Parent then frame:Destroy() end
        ReorganizeNoti()
    end)
end

function Notification.Show(config)
    if not notiHolder or not notiHolder.Parent then return nil end
    config = config or {}
    local nType = config.Type or "info"
    local title = config.Title or "Thông báo"
    local desc = config.Desc or config.Text or ""
    local dur = config.Duration or 4
    local icon = config.Icon or NOTI_ICONS[nType] or "ℹ"
    local color = NOTI_COLORS[nType] and NOTI_COLORS[nType]() or Theme.Info

    local frame = U.New("Frame", {
        Name = "Noti_" .. tostring(math.random(10000, 99999)),
        Size = UDim2.new(0, NOTI_W, 0, NOTI_H),
        Position = UDim2.new(0, -NOTI_W - 20, 0, 0),
        BackgroundColor3 = Theme.Surface, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 9999,
    }, notiHolder)
    U.Corner(Theme.RadiusLarge, frame)
    local stroke = U.Stroke(Theme.Border, 1, 1, frame)

    local accent = U.New("Frame", {
        Name = "AccentBar", Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = color, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10000,
    }, frame)
    U.Corner(Theme.RadiusTiny, accent)

    local iconF = U.New("Frame", {
        Name = "IconFrame", Size = UDim2.new(0, 36, 0, 36),
        Position = UDim2.new(0, 16, 0.5, -18),
        BackgroundColor3 = color, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10000,
    }, frame)
    U.Corner(Theme.RadiusFull, iconF)
    U.New("TextLabel", {
        Name = "Icon", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = icon, Font = Theme.FontBlack, TextSize = 16,
        TextColor3 = Theme.Background, TextTransparency = 1, ZIndex = 10001,
    }, iconF)

    U.New("TextLabel", {
        Name = "Title", Size = UDim2.new(1, -80, 0, 18), Position = UDim2.new(0, 62, 0, 14),
        BackgroundTransparency = 1, Text = title, Font = Theme.FontBold, TextSize = Theme.SizeMedium,
        TextColor3 = color, TextTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 10000,
    }, frame)

    U.New("TextLabel", {
        Name = "Desc", Size = UDim2.new(1, -80, 0, 26), Position = UDim2.new(0, 62, 0, 32),
        BackgroundTransparency = 1, Text = desc, Font = Theme.FontRegular, TextSize = Theme.SizeNormal,
        TextColor3 = Theme.TextDim, TextTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 10000,
    }, frame)

    local progBar, progFill
    if dur > 0 then
        progBar = U.New("Frame", {
            Name = "ProgressBar", Size = UDim2.new(1, -20, 0, 2), Position = UDim2.new(0, 10, 1, -4),
            BackgroundColor3 = Theme.SurfaceDeep, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10000,
        }, frame)
        U.Corner(Theme.RadiusTiny, progBar)
        progFill = U.New("Frame", {
            Name = "Fill", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = color,
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10001,
        }, progBar)
        U.Corner(Theme.RadiusTiny, progFill)
    end

    local click = U.New("TextButton", {
        Name = "ClickArea", Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 10002,
    }, frame)

    local noti = { frame = frame, type = nType, timerConn = nil }
    table.insert(notiStack, noti)

    U.Tween(frame, Theme.AnimSmooth, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0 })
    task.delay(0.05, function()
        if not frame or not frame.Parent then return end
        U.Tween(frame.AccentBar, Theme.AnimNormal, { BackgroundTransparency = 0 })
        U.Tween(frame.IconFrame, Theme.AnimNormal, { BackgroundTransparency = 0 })
        U.Tween(frame.IconFrame.Icon, Theme.AnimNormal, { TextTransparency = 0 })
        U.Tween(frame.Title, Theme.AnimNormal, { TextTransparency = 0 })
        U.Tween(frame.Desc, Theme.AnimNormal, { TextTransparency = 0 })
        U.Tween(stroke, Theme.AnimNormal, { Transparency = 0 })
        if progBar then
            U.Tween(progBar, Theme.AnimNormal, { BackgroundTransparency = 0.3 })
            U.Tween(progFill, Theme.AnimNormal, { BackgroundTransparency = 0 })
        end
    end)

    if dur > 0 then
        local startTime = tick()
        local conn
        conn = Svc.RunService.Heartbeat:Connect(function()
            if not frame or not frame.Parent then
                if conn then conn:Disconnect() end; return
            end
            local elapsed = tick() - startTime
            local prog = math.clamp(1 - elapsed / dur, 0, 1)
            if progFill and progFill.Parent then
                progFill.Size = UDim2.new(prog, 0, 1, 0)
                if prog < 0.25 then progFill.BackgroundColor3 = Theme.Danger
                elseif prog < 0.5 then progFill.BackgroundColor3 = Theme.Warning
                else progFill.BackgroundColor3 = color end
            end
            if elapsed >= dur then
                if conn then conn:Disconnect() end
                DismissNoti(noti)
            end
        end)
        noti.timerConn = conn
    end

    click.MouseButton1Click:Connect(function() DismissNoti(noti) end)
    ReorganizeNoti()
    return noti
end

function Notification.Info(t, d, dur) return Notification.Show({ Type = "info", Title = t, Desc = d, Duration = dur }) end
function Notification.Success(t, d, dur) return Notification.Show({ Type = "success", Title = t, Desc = d, Duration = dur }) end
function Notification.Warning(t, d, dur) return Notification.Show({ Type = "warning", Title = t, Desc = d, Duration = dur }) end
function Notification.Danger(t, d, dur) return Notification.Show({ Type = "danger", Title = t, Desc = d, Duration = dur }) end
function Notification.Loading(t, d) return Notification.Show({ Type = "loading", Title = t, Desc = d, Duration = 0 }) end

