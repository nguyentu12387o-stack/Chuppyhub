local Remote = {}
local function GetCommF() local remotes = ReplicatedStorage:FindFirstChild("Remotes"); return remotes and remotes:FindFirstChild("CommF_") end
local function GetCommE() local remotes = ReplicatedStorage:FindFirstChild("Remotes"); return remotes and remotes:FindFirstChild("CommE") end

function Remote.Invoke(...)
    local commF = GetCommF()
    if not commF then return nil end
    local args = { ... }
    local unpackFn = table.unpack or unpack
    local ok, res = pcall(function() return commF:InvokeServer(unpackFn(args)) end)
    if not ok then warn("[Chuppy Remote] Invoke error:", res); return nil end
    return res
end

function Remote.FireCommE(...)
    local commE = GetCommE()
    if not commE then return false end
    local args = { ... }
    local unpackFn = table.unpack or unpack
    local ok = pcall(function() commE:FireServer(unpackFn(args)) end)
    return ok
end

function Remote.Fire(remote, ...)
    if not remote then return false end
    local args = { ... }
    local unpackFn = table.unpack or unpack
    local ok = pcall(function() remote:FireServer(unpackFn(args)) end)
    return ok
end

