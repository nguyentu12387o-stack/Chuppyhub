            U.Tween(track, info, { BackgroundColor3 = Theme.Surface3 })
            U.Tween(knob, Theme.AnimSpring, { Position = UDim2.new(0, 2, 0.5, -9), BackgroundColor3 = Theme.TextDim })
            U.Tween(frameStroke, info, { Color = Theme.Border, Transparency = 0.7 })
            U.Tween(title, info, { TextColor3 = Theme.Text })
        end
    end

    local clickable = U.New("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, ZIndex = 5,
    }, frame)

    clickable.MouseButton1Click:Connect(function()
        if disabled then return end
        state = not state
        updateVisual()
        Anim.Pulse(frame, 1.015, 0.15)
        if callback then pcall(callback, state) end
    end)

    clickable.MouseEnter:Connect(function()
        if disabled then return end
        U.Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.Surface3 })
        U.Tween(frameStroke, Theme.AnimFast, { Transparency = 0.4 })
    end)
    clickable.MouseLeave:Connect(function()
        U.Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.Surface2 })
        U.Tween(frameStroke, Theme.AnimFast, { Transparency = 0.7 })
    end)

    if tooltip then Tooltip.Attach(frame, tooltip) end
    self.flags[flag] = { type = "toggle", value = state }

    return {
        Set = function(v) if state ~= v then state = v; updateVisual(true); if callback then pcall(callback, state) end end end,
        Get = function() return state end,
        SetDisabled = function(v) disabled = v; frame.BackgroundTransparency = v and 0.5 or 0 end,
        Flag = flag,
    }
end

