function UILibrary:AddSlider(config, callback)
    config = config or {}
    local name = config.Name or "Slider"
    local min = config.Min or 0
    local max = config.Max or 100
    local default = config.Default or min
    local step = config.Step or 1
    local suffix = config.Suffix or ""
    local precise = config.Precise or false
    local value = math.clamp(default, min, max)

    local frame = U.New("Frame", {
        Name = "Slider_" .. name, Size = UDim2.new(1, 0, 0, 52),
        BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0, LayoutOrder = self._elementCount + 1,
    }, self._container or self._page)
    U.Corner(Theme.RadiusSmall, frame)
    local frameStroke = U.Stroke(Theme.Border, 1, 0.7, frame)
    self._elementCount = self._elementCount + 1

    U.New("TextLabel", {
        Name = "Title", Size = UDim2.new(0.6, -12, 0, 18), Position = UDim2.new(0, 12, 0, 6),
        BackgroundTransparency = 1, Text = name, Font = Theme.FontMedium, TextSize = Theme.SizeMedium,
        TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    }, frame)

    local valueLabel = U.New("TextLabel", {
        Name = "Value", Size = UDim2.new(0.4, -12, 0, 18), Position = UDim2.new(0.6, 0, 0, 6),
        BackgroundTransparency = 1, Text = tostring(value) .. suffix, Font = Theme.FontBold,
        TextSize = Theme.SizeMedium, TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Right,
    }, frame)

    local track = U.New("Frame", {
        Name = "Track", Size = UDim2.new(1, -24, 0, 8), Position = UDim2.new(0, 12, 0, 32),
        BackgroundColor3 = Theme.SurfaceDeep, BorderSizePixel = 0,
    }, frame)
    U.Corner(Theme.RadiusFull, track)

    local fill = U.New("Frame", {
        Name = "Fill", Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
    }, track)
    U.Corner(Theme.RadiusFull, fill)

    local knob = U.New("Frame", {
        Name = "Knob", Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new((value - min) / (max - min), -8, 0.5, -8),
        BackgroundColor3 = Theme.TextBright, BorderSizePixel = 0, ZIndex = 3,
    }, track)
    U.Corner(Theme.RadiusFull, knob)
    U.Stroke(Theme.Accent, 2, 0, knob)

    local dragging = false
    local trackInput = U.New("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, ZIndex = 5,
    }, track)

    local function updateFromX(relX)
        relX = math.clamp(relX, 0, 1)
        local rawValue = min + (max - min) * relX
        local finalValue
        if precise then finalValue = math.floor(rawValue * 100) / 100
        else finalValue = math.clamp(math.floor(rawValue / step + 0.5) * step, min, max) end
        value = finalValue
        local rel = (value - min) / (max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -8, 0.5, -8)
        valueLabel.Text = tostring(value) .. suffix
        if callback then pcall(callback, value) end
    end

    trackInput.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
            U.Tween(knob, Theme.AnimFast, { Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(knob.Position.X.Scale, -10, 0.5, -10) })
        end
    end)
    trackInput.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateFromX((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
        end
    end)
    trackInput.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            U.Tween(knob, Theme.AnimSpring, { Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(knob.Position.X.Scale, -8, 0.5, -8) })
        end
    end)
    trackInput.MouseEnter:Connect(function() U.Tween(frameStroke, Theme.AnimFast, { Transparency = 0.4 }) end)
    trackInput.MouseLeave:Connect(function() U.Tween(frameStroke, Theme.AnimFast, { Transparency = 0.7 }) end)

    return {
        Set = function(v)
            v = math.clamp(v, min, max); value = v
            local rel = (value - min) / (max - min)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, -8, 0.5, -8)
            valueLabel.Text = tostring(value) .. suffix
            if callback then pcall(callback, value) end
        end,
        Get = function() return value end,
    }
end

function UILibrary:AddDropdown(config, callback)
    config = config or {}
    local name = config.Name or "Dropdown"
    local options = config.Options or config.List or {}
    local default = config.Default or options[1]
    local multi = config.Multi or false
    local search = config.Search or false

    local frame = U.New("Frame", {
        Name = "Dropdown_" .. name, Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0,
        LayoutOrder = self._elementCount + 1, ZIndex = 3,
    }, self._container or self._page)
