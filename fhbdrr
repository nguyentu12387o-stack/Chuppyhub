local U = {}

function U.New(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then pcall(function() obj[k] = v end) end
    end
    if parent then obj.Parent = parent end
    return obj
end

function U.Corner(radius, parent)
    return U.New("UICorner", { CornerRadius = radius or Theme.Radius }, parent)
end

function U.Stroke(color, thickness, transparency, parent)
    return U.New("UIStroke", {
        Color = color or Theme.Border, Thickness = thickness or 1,
        Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

function U.Padding(top, bottom, left, right, parent)
    return U.New("UIPadding", {
        PaddingTop = UDim.new(0, top or 0), PaddingBottom = UDim.new(0, bottom or 0),
        PaddingLeft = UDim.new(0, left or 0), PaddingRight = UDim.new(0, right or 0),
    }, parent)
end

function U.Tween(obj, info, props)
    if not obj or not obj.Parent then return nil end
    local t = Svc.TweenService:Create(obj, info or Theme.AnimNormal, props)
    t:Play()
    return t
end

function U.LerpColor(a, b, alpha)
    return a:Lerp(b, math.clamp(alpha, 0, 1))
end

function U.TextSize(font, size, text)
    local label = Instance.new("TextLabel")
    label.TextSize = size; label.Font = font; label.Text = text or ""
    local bounds = label.TextBounds
    label:Destroy()
    return bounds
end

function U.FormatNumber(n)
    local formatted = tostring(math.floor(tonumber(n) or 0))
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return formatted
end

function U.FormatTime(seconds)
    seconds = math.floor(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    if h > 0 then return string.format("%dh %dm %ds", h, m, s) end
    if m > 0 then return string.format("%dm %ds", m, s) end
    return string.format("%ds", s)
end

getgenv().ChuppyU = U

