-- [3.7] LEVEL STATS TRACKING
-- ═══════════════════════════════════════════════════════════════════════════════
local LevelStats = {}
local startLevel = PlayerUtils.GetLevel()

function LevelStats.GetSession()
    local cur = PlayerUtils.GetLevel()
    return {
        startLevel = startLevel, currentLevel = cur, levelsGained = cur - startLevel,
        mobsKilled = State.Stats.MobsKilled, sessionTime = math.floor(tick() - State.StartTime), perMinute = 0,
    }
end

function LevelStats.FormatSession()
    local s = LevelStats.GetSession()
    local mins = math.max(1, math.floor(s.sessionTime / 60))
    local killsPerMin = math.floor(s.mobsKilled / mins)
    return string.format("[Lv %d→%d] +%d lvl | %d kills | %.1f kills/phút", s.startLevel, s.currentLevel, s.levelsGained, s.mobsKilled, killsPerMin)
end
