-- [3.2] QUEST STATUS READER
-- ═══════════════════════════════════════════════════════════════════════════════
local QuestStatus = {}

local function GetMainGui()
    local pg = LP:FindFirstChild("PlayerGui")
    return pg and pg:FindFirstChild("Main")
end

function QuestStatus.GetInfo()
    local main = GetMainGui()
    if not main then return { hasQuest = false, title = "", mob = "", progress = 0, goal = 0 } end
    local questUI = main:FindFirstChild("Quest")
    if not questUI or not questUI.Visible then return { hasQuest = false, title = "", mob = "", progress = 0, goal = 0 } end

    local title = ""
    local mob = ""
    pcall(function()
        local container = questUI:FindFirstChild("Container")
        if container then
            local qTitle = container:FindFirstChild("QuestTitle")
            if qTitle and qTitle:FindFirstChild("Title") then title = qTitle.Title.Text or "" end
        end
    end)

    if title ~= "" then
        pcall(function()
            local m = string.match(title, "Defeat%s+%d+%s+(.+)")
            if m then mob = m end
        end)
    end
    return { hasQuest = true, title = title, mob = mob, progress = 0, goal = 0 }
end

function QuestStatus.IsOnQuest(questName, mobName)
    local info = QuestStatus.GetInfo()
    if not info.hasQuest then return false end
    if mobName then
        local lower = string.lower(mobName)
        if not string.find(string.lower(info.title), lower, 1, true) then return false end
    end
    return true
end

function QuestStatus.HasActive() return QuestStatus.GetInfo().hasQuest end
getgenv().ChuppyQuestStatus = QuestStatus

